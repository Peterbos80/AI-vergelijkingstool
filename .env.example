# ─────────────────────────────────────────────────────────────────────────────
# AIToolsWijzer — environment variables
# Copy to .env.local (web) or .env (scripts/worker). Never commit real values.
# Every optional integration degrades honestly when unset and shows up in
# Admin → Automation → Dependencies.
# ─────────────────────────────────────────────────────────────────────────────

# Required ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS, local Docker, …)
DATABASE_URL=postgres://aitw:aitw@localhost:5432/aitoolswijzer

# Public base URL, used for canonical URLs, sitemaps, OG images and e-mails.
SITE_URL=http://localhost:3000

# ≥ 32 characters. Salts visitor hashes (rotated daily), signs tokens and
# sessions. Generate with: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Bearer token for POST /api/cron/agents (scheduler/cron). ≥ 16 characters;
# generate with: openssl rand -hex 24. Without it the endpoint answers 503.
CRON_SECRET=

# Owner / autonomy (docs/strategy/12) ────────────────────────────────────────
# Receives P1 alerts and the weekly report. Without it, both stay in Admin.
OWNER_EMAIL=
# External dead man's switch (e.g. a Healthchecks.io ping URL). The worker
# pings it after every cycle; the external service alerts you when it stops.
HEARTBEAT_URL=
# Optional: create GitHub issues for new recurring code errors (owner/repo).
GITHUB_ISSUES_REPO=

# Optional: AI ────────────────────────────────────────────────────────────────
# Without a key the deterministic (lexical) engine is used everywhere.
ANTHROPIC_API_KEY=
# Model for LLM features. Choosing a cheaper model is an owner decision.
ANTHROPIC_MODEL=claude-opus-5-5
# Hard daily spend cap for all LLM calls in USD (then: deterministic fallback).
LLM_DAILY_BUDGET_USD=5
# Use the LLM for Match intent when lexical confidence is low (true/false).
LLM_MATCH_ENABLED=true

# Optional: e-mail ────────────────────────────────────────────────────────────
# Without a key e-mails are kept in the email_outbox table (visible in Admin).
RESEND_API_KEY=
EMAIL_FROM="AIToolsWijzer <alerts@aitoolswijzer.nl>"

# Optional: data sources for agents ───────────────────────────────────────────
GITHUB_TOKEN=
YOUTUBE_API_KEY=

# Optional: agent fetcher ─────────────────────────────────────────────────────
# Enable the Playwright renderer for sources marked fetch_mode=render.
AGENT_ENABLE_RENDERER=false
AGENT_USER_AGENT="AIToolsWijzerBot/1.0 (+https://aitoolswijzer.nl/bot)"

# Locales ─────────────────────────────────────────────────────────────────────
# Comma-separated override of live locales (default: nl,en).
ENABLED_LOCALES=

# Admin bootstrap (used by `npm run admin:create` when no flags are given) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Legal identity shown on /about (required before launch; Admin → Launch
# readiness blocks until complete).
LEGAL_NAME=
LEGAL_KVK=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# AIToolsWijzer — environment variables
# Copy to .env.local (web) or .env (scripts/worker). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Required ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS, local Docker, …)
DATABASE_URL=postgres://aitw:aitw@localhost:5432/aitoolswijzer

# Public base URL, used for canonical URLs, sitemaps, OG images and e-mails.
SITE_URL=http://localhost:3000

# Secret used to hash visitor identifiers (rotated daily with the date) and to
# sign edit tokens. Generate with: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# Bearer token for POST /api/cron/agents and /api/revalidate.
CRON_SECRET=change-me-too

# Optional: AI ────────────────────────────────────────────────────────────────
# Without a key the deterministic (lexical) engine is used everywhere.
ANTHROPIC_API_KEY=
# Override models if needed (defaults are set in src/lib/llm/models.ts).
LLM_MODEL_FAST=
LLM_MODEL_SMART=
# Daily spend cap for LLM calls in USD (hard stop → fallback engine).
LLM_DAILY_BUDGET_USD=5

# Optional: e-mail ────────────────────────────────────────────────────────────
# Without a key e-mails are written to the email_outbox table (visible in Admin).
RESEND_API_KEY=
EMAIL_FROM="AIToolsWijzer <alerts@aitoolswijzer.nl>"

# Optional: data sources for agents ───────────────────────────────────────────
GITHUB_TOKEN=
YOUTUBE_API_KEY=
PRODUCT_HUNT_TOKEN=

# Optional: agent fetcher ─────────────────────────────────────────────────────
# Enable the Playwright renderer for sources marked fetch_mode=render.
AGENT_ENABLE_RENDERER=false
# Contact URL that is sent in the bot user-agent string.
AGENT_CONTACT_URL=https://aitoolswijzer.nl/bot

# Optional: admin bootstrap (used by `npm run admin:create` when no flags given)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Legal identity shown on /about (required before launch; Admin → Launch
# readiness flags missing values).
LEGAL_ENTITY_NAME=
LEGAL_CHAMBER_OF_COMMERCE=
LEGAL_ADDRESS=
CONTACT_EMAIL=
